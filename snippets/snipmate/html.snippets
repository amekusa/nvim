snippet :comment
	<!-- $1 -->

snippet <!DOCTYPE_html>
	<!DOCTYPE html>

snippet <tag_class="...">...</tag>
	<${1:div} class="$2">$3</$1>

snippet <tag>...</tag>
	<${1:div}>$2</$1>

snippet <kbd>...</kbd>
	<kbd>$1</kbd>

snippet <link_rel="stylesheet"_href="style.css">
	<link rel="stylesheet" href="${1:style.css}">

snippet <meta_charset="utf-8">
	<meta charset="utf-8">

snippet <div>...</div>
	<div>$1</div>

snippet <div_class="...">...</div>
	<div class="$1">$2</div>

snippet <a_href="...">...</a>
	<a href="$1">$2</a>

snippet <img_src="...">
	<img src="$1">

snippet <figure>...</figure>
	<figure>$1</figure>

snippet <figcaption>...</figcaption>
	<figcaption>$1</figcaption>

