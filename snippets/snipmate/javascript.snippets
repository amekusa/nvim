snippet #!/usr/bin/env_node :shebang
	#!/usr/bin/env node

snippet .then(__=>__)
	.then($1 => $2)

snippet /**_:docblock_*/
	/**
	 * $1
	 */

snippet :arrow
	$1 => {$0}

snippet :arrow-paren
	($1) => {$0}

snippet :debug-var
	console.debug('${1:var}:', $1);

snippet :for
	for (let ${1:i} = 0; $1 < $2; $1++) {$0}

snippet :for-array
	for (let ${1:i} = ${2:0}; $1 < ${3:arr}.length; $1++) {
		$0$3[$1]
	}

snippet :for-in-obj
	for (let ${1:k} in ${2:obj}) {
		$0$2[$1];
	}

snippet :for-map-keys
	for (let ${1:k} of ${2:map}.keys()) {
		$0$2.get(k);
	}

snippet :for-obj-keys
	let ${1:keys} = Object.keys(${2:obj});
	for (let ${3:i} = 0; $3 < $1.length; $3++) {
		let k = $1[$3];
		let v = $2[k];
		$0
	}

snippet :method
	$1($2) {
		$0
	}

snippet @param_{_}___-__
	@param {${1:type}} ${2:name} - 

snippet @return_{_}__
	@return {${1:type}}${2: desc}

snippet Array.isArray(_)
	Array.isArray($1)

snippet case__:
	case $1:
		$0

snippet console.debug(_) :debug
	console.debug($1);

snippet console.log(_) :log
	console.log($1);

snippet const___=__
	const $1 = $2;

snippet const___=_require('_') :require
	const $1 = require('$2');

snippet constructor(_)_{_..._}
	constructor(${1:}) {
		$0
	}

snippet export__
	export $0

snippet export___as___from__
	export ${1:*} as $2 from '$3';

snippet export_default__
	export default ${1:}

snippet function__(_)_{_..._}
	function $1($2) {$0}

snippet if_(_)_{_..._} :if-braces
	if ($1) {$0}

snippet import___from_'_'
	import $1 from '$2';

snippet let___=__
	let $1 = $2;

snippet new_Error(_,_{cause:__}) :error-cause
	new Error(`$1`, {cause: $2})

snippet new_Promise((done,_fail)_=>_{_..._})
	new Promise((${1:done}, ${2:fail}) => {$0})

snippet switch_(_)_{_..._} :switch-case
	switch ($1) {
	case $2:
		$0
		break;
	}

snippet switch_(typeof__)_{_..._}
	switch (typeof $1) {
	case '$2':
		$0
		break;
	}

snippet undefined
	undefined

snippet {@link__}
	{@link $1}

