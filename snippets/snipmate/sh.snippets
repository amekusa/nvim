snippet :ansi-colors
	if [[ -t 1  && -z "$NO_COLOR" ]]; then
		red=$'\e[0;31m'
		grn=$'\e[0;32m'
		ylw=$'\e[0;33m'
		mag=$'\e[0;35m'
		cyn=$'\e[0;36m'
		bld=$'\e[1m'
		und=$'\e[4m'
		rst=$'\e[0m'
	fi
	_ok()    { echo -e "[${grn}OK${rst}] $*" }
	_warn()  { echo -e "[${ylw}Warning${rst}] $*" }
	_error() { echo -e "[${red}Error${rst}] $*" >&2; return 1 }

snippet :arr-item
	\${${1:arr}[${2:0}]}

snippet :arr-items
	\${${1:arr}[@]}

snippet :arr-length
	\${#${1:arr}[@]}

snippet :arr-push
	${1:arr}+=(${2:item})

snippet :arr-concat
	${1:arr}+=("\${${2:arr2}[@]}")

snippet :arr-rm
	unset '${1:arr}[${2:0}]'

snippet :arr-rm-last
	unset '${1:arr}[\${#$1[@]}-1]'

snippet ${BASH_SOURCE[0]} # $0 but better
	${BASH_SOURCE[0]}

snippet $BASH_VERSINFO
	\$BASH_VERSINFO

snippet ${BASH_REMATCH[***]} # regex match results
	\${BASH_REMATCH[${1:1}]}

snippet :case
	case "\$${1:var}" in
	$2) $0;;
	esac

snippet :case-args
	case "\$1" in
	$2)
		$0
		;;
	-*)
		printf "[Error] Invalid argument: '%s'.\n" "$1" >&2
		return 1
		;;
	esac

snippet :cmd-output
	\$(${1:cmd})

snippet :cond
	[[ $1 ]]

snippet :cond-not_empty
	[[ -n "$1" ]]

snippet :cond-fail-last
	[[ $? -ne 0 ]]

snippet :cond-regex
	[[ "$${1:var}" =~ ${2:regex} ]]

snippet :date-hms
	date +'%H:%M:%S'

snippet :date-seconds
	date +%s

snippet :date-ymd
	date +%F

snippet :date-ymd-hms
	date +'%F %H:%M:%S'

snippet :error
	printf "[Error] $1 '%s'.\n" "\$${2:var}" >&2
	return 1

snippet :fallback-empty
	\${${1:var}:-${fb}}

snippet :for
	local ${1:i}
	for (($1=${2:0}; $1 < ${3:n}; $1++)); do
		$0
	done

snippet :for-args
	local ${1:arg}
	for $1 in "\$@"; do
		$0
	done

snippet :for-arr
	local ${1:each}
	for $1 in "${${2:arr}[@]}"; do
		$0
	done

snippet :for-arr-index
	local ${1:i}
	for $1 in "\${!${2:arr}[@]}"; do
		$0"\${$2[\$$1]}"
	done

snippet :for-str
	local ${1:i}
	for (($1=0; $1 < \${#${2:str}}; $1++)); do
		$0"\${$2:$1:1}"
	done

snippet ${FUNCNAME[0]}
	\${FUNCNAME[0]}

snippet :has-cmd
	command -v "${1:cmd}" &>/dev/null

snippet :help
	if [[ $# -eq 0 || "\$1" = "--help" || "\$1" = "-h" ]]; then
		cat <<- EOF
		$1
		Usage:
		  $0
		EOF
		return 1
	fi

snippet :heredoc
	cat <<- EOF
	$0
	EOF

snippet :if
	if ${1:cond}; then
		$0
	fi

snippet :if-simple
	if ${1:cond}
		then $2
		else $3
	fi

snippet :if-bash
	if [ -n "\$BASH_VERSINFO" ]; then
		$0
	fi

snippet :if-zsh
	if [ -n "\$ZSH_VERSION" ]; then
		$0
	fi

snippet :if-fail
	if ! ${1:cmd}; then
		$0
	fi

snippet :if-fail-last
	if [ $? -ne 0 ]; then
		$0
	fi

snippet :local-var
	local ${1:var}

snippet :local-var-arr
	local -a ${1:var}

snippet :lowercase
	\$(tr '[:upper:]' '[:lower:]' <<< "\$${1:str}")

snippet :no-output
	&>/dev/null

snippet :printf
	printf "$1.\n"

snippet :printf-var
	printf "$1 '%s'.\n" "\$${2:var}"

snippet :printf-var-debug
	printf "\\$${1:var}: '%s'.\n" "\$$1"

snippet :path-extension
	\${${1:path}##*.}

snippet :prompt
	while true; do
		local ${2:answer}
		read -n 1 -p "${1:msg}? [Y/N] > " $2 || answer=N; echo
		case "\$$2" in
		[Yy])
			$3
			break
			;;
		[Nn])
			$4
			break
			;;
		*)
			printf "Answer with Y or N.\n"
			;;
		esac
	done

snippet :regex-space
	[[:space:]]

snippet :shebang
	#!/usr/bin/env ${1:bash}

snippet :split-into-arr
	IFS='${1:sep}' read -ra ${2:arr} <<< "\$${3:str}"

snippet :substr-offset
	\${${1:str}:${2:offset}}

snippet :substr-offset+length
	\${${1:str}:${2:offset}:${3:length}}

snippet :substr-remove-left
	\${${1:str}#*${2:to}}

snippet :substr-remove-left(greed)
	\${${1:str}##*${2:to}}

snippet :substr-remove-right
	\${${1:str}%${2:from}*}

snippet :substr-remove-right(greed)
	\${${1:str}%%${2:from}*}

snippet :stderr
	>&2

snippet :then
	then
		$0
	fi

snippet :this # current script name
	\${BASH_SOURCE[0]##*/}

snippet :var
	\$${1:var}

snippet :var-quoted
	"\$${1:var}"

snippet :while-args
	while [ $# -gt 0 ]; do
		$0
		shift
	done

snippet :while-lines
	local ${1:line}
	while IFS= read -r $1; do
		$0
	done <<< "\$${2:str}"

snippet :while-lines-in-file
	local ${1:line}
	while IFS= read -r $1; do
		$0
	done < ${2:file}

snippet $ZSH_VERSION
	\$ZSH_VERSION

