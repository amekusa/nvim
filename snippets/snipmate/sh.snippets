snippet $BASH_VERSINFO
	\$BASH_VERSINFO

snippet ${FUNCNAME[0]}
	\${FUNCNAME[0]}

snippet ${BASH_REMATCH[_]}
	\${BASH_REMATCH[${1:1}]}

snippet $ZSH_VERSION
	\$ZSH_VERSION

snippet :arr_item
	\${${1:arr}[${2:0}]}

snippet :arr_items
	"\${${1:arr}[@]}"

snippet :arr_length
	\${#${1:arr}[@]}

snippet :arr_push
	${1:arr}+=(${2:item})

snippet :arr_concat
	${1:arr}+=("\${${2:arr2}[@]}")

snippet :arr_rm
	unset '${1:arr}[${2:0}]'

snippet :arr_rm_last
	unset '${1:arr}[\${#$1[@]}-1]'

snippet :case
	case "\$${1:var}" in
	$2) $0;;
	esac

snippet :case_args
	case "\$1" in
	$2)
		$0
		;;
	-*)
		printf "[Error] Invalid argument: '%s'\n" "$1" >&2
		return 1
		;;
	esac

snippet :ansi_colors
	if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
		red=$'\e[0;31m'
		grn=$'\e[0;32m'
		ylw=$'\e[0;33m'
		mag=$'\e[0;35m'
		cyn=$'\e[0;36m'
		bld=$'\e[1m'
		und=$'\e[4m'
		rst=$'\e[0m'
	fi
	_ok() {
		echo -e "[${grn}OK${rst}] $*"
	}
	_warn() {
		echo -e "[${ylw}WARN${rst}] $*"
	}
	_error() {
		echo -e "[${red}ERROR${rst}] $*" >&2; return 1
	}

snippet :cond_not_empty
	[ -n "$1" ]

snippet :date_hms
	date +'%H:%M:%S'

snippet :date_seconds
	date +%s

snippet :date_ymd
	date +%F

snippet :date_ymd_hms
	date +'%F %H:%M:%S'

snippet :printf_var
	printf '\$${1:var}: %s\n' "\$$1"

snippet :fallback_empty
	\${${1:var}:-${fb}}

snippet :for
	local ${1:i}
	for ((${1}=${2:0}; ${1} < ${3:n}; ${1}++)); do
		$0
	done

snippet :for_args
	for ${1:arg} in "\$@"; do
		$0
	done

snippet :for_arr
	for ${1:each} in "${${2:arr}[@]}"; do
		$0
	done

snippet :for_arr_index
	for ${1:i} in "\${!${2:arr}[@]}"; do
		$0"\${${2}[\$${1}]}"
	done

snippet :for_string
	local ${1:i}
	for ((${1}=0; ${1} < \${#${2:str}}; ${1}++)); do
		"\${${2}:${1}:1}"
	done

snippet :getopts
	local opts
	while getopts '$1abc' opts; do
		case "\$opts" in
		$2a) flag_a=1 ;;
		b) flag_b=1 ;;
		c) flag_c=1 ;;
		?) exit 1 ;;
		esac
	done

snippet :has_command
	command -v "${1:cmd}" &> /dev/null

snippet :help
	if [ $# -eq 0 ] || [ "\$1" = "--help" ] || [ "\$1" = "-h" ]; then
		cat <<- EOF
		Usage:
		  $0
		EOF
		return 1
	fi

snippet :heredoc
	cat <<- EOF
	$0
	EOF

snippet :if
	if ${1:cond}; then
		$0
	fi

snippet :if_bash
	if [ -n "\$BASH_VERSINFO" ]; then
		$0
	fi

snippet :if_zsh
	if [ -n "\$ZSH_VERSION" ]; then
		$0
	fi

snippet :path_extension
	\${${1:path}##*.}

snippet :prompt
	while true; do
		read -n 1 -p "${1:msg}? (Y/N) " ${2:answer}; echo
		case "$${2:answer}" in
		[Yy])
			$3
			break
			;;
		[Nn])
			$4
			break
			;;
		*)
			echo "Type Y or N"
		esac
	done

snippet :regex
	[[ "$${1:var}" =~ ${2:regex} ]]

snippet :regex_space
	[[:space:]]

snippet :shebang
	#!/usr/bin/env ${1:bash}

snippet :split_into_arr
	IFS='${1:sep}' read -ra ${2:arr} <<< "\$${3:str}"

snippet :substr_offset
	\${${1:str}:${2:offset}}

snippet :substr_offset+length
	\${${1:str}:${2:offset}:${3:length}}

snippet :substr_remove_from
	\${${1:str}%${2:from}*}

snippet :substr_remove_from(greed)
	\${${1:str}%%${2:from}*}

snippet :substr_remove_to
	\${${1:str}#*${2:to}}

snippet :substr_remove_to(greed)
	\${${1:str}##*${2:to}}

snippet :no_output
	&> /dev/null

snippet :stderr
	>&2

snippet :while_args
	while [ $# -gt 0 ]; do
		$0
		shift
	done

snippet :while_lines
	local IFS ${1:line}
	while IFS= read -r ${1}; do
		$0
	done < ${2:file}

snippet local_***
	local ${1:var}

snippet then_***_fi
	then
		$0
	fi

